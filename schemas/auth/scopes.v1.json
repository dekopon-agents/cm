{
  "version": 1,
  "audience": "campaign-trail-api",
  "matching": "exact-case-sensitive",
  "scope_implication": "none",
  "unknown_scopes": "grant-nothing",
  "scopes": {
    "cm:campaigns:read": "Read campaign state and consistent views.",
    "cm:campaigns:write": "Create campaigns and edit unaccepted campaign drafts.",
    "cm:campaigns:approve": "Approve a campaign plan or scope revision.",
    "cm:campaigns:close": "Close a campaign after its outstanding obligations are accounted for.",
    "cm:cards:read": "Read cards, readiness, dependencies and accepted work packets.",
    "cm:cards:write": "Create cards and edit unaccepted card drafts, dependencies and metadata.",
    "cm:cards:approve": "Approve a card revision and its acceptance criteria or execution grant.",
    "cm:cards:advance": "Request a card state transition; applicable evidence and state guards still apply.",
    "cm:reviews:read": "Read review cards, rounds and stable finding histories.",
    "cm:reviews:start": "Admit one formal review round within its declared cap.",
    "cm:reviews:record": "Collect a native review result; supplied labels do not establish reviewer identity.",
    "cm:reviews:adjudicate": "Resolve a disputed finding or append an evidence-backed correction to a review subject.",
    "cm:sessions:read": "Read managed session status, declared purpose, limits and native receipts.",
    "cm:sessions:start": "Admit a managed worker or helper under an accepted card and remaining limits.",
    "cm:sessions:stop": "Request checkpoint and termination; a request is not confirmation that a session stopped.",
    "cm:spend:read": "Read usage, API-equivalent cost, actual charges and their coverage separately.",
    "cm:spend:record": "Collect deduplicated native usage; arbitrary submitted amounts are not authoritative.",
    "cm:journal:read": "Read linked decisions and their alternatives, evidence and preconditions.",
    "cm:journal:append": "Append a decision or a superseding correction; never overwrite history.",
    "cm:escalations:read": "Read escalations without acknowledging, answering or closing them.",
    "cm:escalations:open": "Open or update a deduplicated escalation linked to its cause.",
    "cm:escalations:resolve": "Answer and close an escalation with an explicit disposition; closure alone grants nothing else.",
    "cm:evidence:read": "Read accepted evidence and its source bindings.",
    "cm:evidence:submit": "Submit an attributed report or artifact; submission does not certify native provenance or acceptance.",
    "cm:evidence:collect": "Fetch and bind native evidence from a recorded run or task.",
    "cm:backups:create": "Create a consistent snapshot without changing campaign authority.",
    "cm:backups:read": "Download a snapshot and its verification manifest.",
    "cm:recovery:inspect": "Inspect recovery state, missing history and unknown operations.",
    "cm:recovery:reconcile": "Collect positive recovery evidence and apply safe reconciliation.",
    "cm:recovery:accept-exposure": "Explicitly accept a named unresolved exposure; never infer acceptance from silence.",
    "cm:releases:prepare": "Prepare a versioned release operation from applicable reviewed inputs.",
    "cm:releases:approve": "Approve the exact release inputs under the campaign policy.",
    "cm:releases:publish": "Publish through the qualified native release path; source and artifact guards still apply.",
    "cm:deployments:apply": "Ship an accepted immutable artifact to an authorized target.",
    "cm:deployments:rollback": "Run an accepted rollback to the named compatible artifact/configuration.",
    "cm:tests:run": "Start a declared integration or smoke test within its task and target bounds.",
    "cm:experiments:run": "Start a declared experiment with its protocol, limits and cleanup obligations.",
    "cm:credentials:revoke": "Revoke a credential identifier; cannot mint tokens or read signing/provider secrets.",
    "cm:watches:write": "Create or change a watch; expiry is not successful completion.",
    "cm:exceptions:approve": "Approve a specifically bounded exception; no blanket bypass of other checks.",
    "cm:observations:record": "Append attributed reports. Cannot end an attempt, clear a flight hold or certify native outcomes, health or usage.",
    "cm:campaigns:reconcile": "Request collection/reconciliation of existing campaign operations; never redispatch an unknown effect.",
    "cm:ideas:write": "Admit or update idea records and outcomes under campaign phase/evidence guards.",
    "cm:reviews:raise-cap": "Explicitly increase a review card round cap with a linked escalation disposition; never reset round history.",
    "cm:lanes:read": "Read lane inventory, health projections, queue order and history; nested resources require their read scopes.",
    "cm:lanes:write": "Create, pause, resume or retire lanes; setting limits also requires campaign approval, and immutable bindings/flight guards apply.",
    "cm:lanes:edit-queue": "Attach, detach, move or reorder non-flight cards; never override claims, unknown effects or accepted work.",
    "cm:tracks:read": "Read work-track definitions, footprints, limits and routing.",
    "cm:tracks:write": "Create work tracks or edit metadata; limit changes also require campaign approval, routing uses its separate scope.",
    "cm:tracks:route": "Change the ordered primary and fallback lanes and automatic-fallback policy for a track.",
    "cm:executors:read": "Read executor configuration, source-bound health and meter freshness.",
    "cm:executors:configure": "Pause or resume an executor; cannot set capabilities, probe policy, health or meter state.",
    "cm:executors:probe": "Request a qualified capability probe; paid canaries need the ordinary test and session scopes.",
    "cm:artifacts:read": "Read native artifact bindings, observed state and attention reasons.",
    "cm:artifacts:write": "Bind or rebind artifacts to durable cards and tracks without rewriting native evidence.",
    "cm:credentials:delegate": "Authorize trusted-issuer minting of an explicitly narrower child JWT; never sign with bearer bytes, widen scopes/resources/lifetime, or inherit redelegation automatically.",
    "cm:pulls:merge": "Merge the exact qualified pull request revision in an authorized repository.",
    "cm:recovery:accept-operation-exposure": "Record an explicit disposition of one named uncertain operation within its campaign.",
    "cm:recovery:attest-exclusion": "Record evidence of retired sender exclusion for an instance recovery."
  },
