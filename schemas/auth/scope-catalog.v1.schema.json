{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cm:auth:scope-catalog:v1",
  "title": "cm API action scope catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "audience",
    "matching",
    "scope_implication",
    "unknown_scopes",
    "scopes",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "audience": {
      "const": "campaign-trail-api"
    },
    "matching": {
      "const": "exact-case-sensitive"
    },
    "scope_implication": {
      "const": "none"
    },
    "unknown_scopes": {
      "const": "grant-nothing"
    },
    "scopes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^cm:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public",
          "all_of"
        ],
        "properties": {
          "public": {
            "type": "boolean"
          },
          "all_of": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^cm:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "public": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "all_of": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "all_of": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
